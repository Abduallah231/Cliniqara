generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// Account & Clinic
// =========================

enum AccountType {
  DOCTOR
  RECEPTION
}

enum DoctorLevel {
  INTERN
  DOCTOR
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClinicRole {
  OWNER
  DOCTOR
  RECEPTION
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum WeekDay {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum InvestigationStatus {
  REQUESTED
  COMPLETED
  CANCELLED
}

enum VisitStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
}

enum PrescriptionTemplateScope {
  USER
  CLINIC
  GLOBAL
}

// =========================
// User
// =========================

model User {
  id String @id @default(uuid())

  userCode String @unique

  currentClinicId String?

  accountType AccountType
  doctorLevel DoctorLevel?

  fullName String

  specialty         String?
  professionalTitle String?

  email String @unique
  phone String @unique

  passwordHash String

  nationalId           String?
  medicalLicenseNumber String? @unique

  nationalIdImage     String?
  medicalLicenseImage String?

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  verificationStatus VerificationStatus @default(PENDING)

  isActive Boolean @default(true)

  lastLoginAt DateTime?

  selectedClinicId String?

  selectedClinic Clinic? @relation("UserSelectedClinic", fields: [selectedClinicId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdClinics    Clinic[]       @relation("ClinicCreator")
  currentClinic     Clinic?        @relation("UserCurrentClinic", fields: [currentClinicId], references: [id])
  clinicMemberships ClinicMember[]

  createdVisits Visit[] @relation("VisitCreatedBy")
  doctorVisits  Visit[] @relation("VisitDoctor")

  prescriptionTemplates       PrescriptionTemplate[]
  prescriptionTemplateFolders PrescriptionTemplateFolder[]

  @@index([accountType])
  @@index([verificationStatus])
  @@map("users")
}

// =========================
// Clinic
// =========================

model Clinic {
  id String @id @default(uuid())

  clinicCode String @unique

  name String

  phone String
  email String?

  governorate   String?
  city          String?
  district      String?
  streetAddress String?

  nextVisitNumber Int @default(1)

  workingDays ClinicWorkingDay[]

  isActive Boolean @default(true)

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("ClinicCreator", fields: [createdById], references: [id])

  selectedByUsers User[]           @relation("UserSelectedClinic")
  currentUsers    User[]           @relation("UserCurrentClinic")
  members         ClinicMember[]
  patients        Patient[]
  visits          Visit[]
  joinCodes       ClinicJoinCode[]

  prescriptionTemplates       PrescriptionTemplate[]
  prescriptionTemplateFolders PrescriptionTemplateFolder[]

  @@index([createdById])
  @@index([city])
  @@map("clinics")
}

// =========================
// Clinic Member
// =========================

model ClinicMember {
  id String @id @default(uuid())

  clinicId String
  userId   String

  clinicRole ClinicRole
  status     MembershipStatus @default(ACTIVE)

  joinedAt  DateTime  @default(now())
  removedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([clinicId, userId])
  @@index([clinicId])
  @@index([userId])
  @@index([clinicRole])
  @@map("clinic_members")
}

// =========================
// Clinic Working Shift
// =========================

model ClinicWorkingShift {
  id String @id @default(uuid())

  workingDayId String

  startTime String
  endTime   String

  sortOrder Int @default(0)

  workingDay ClinicWorkingDay @relation(fields: [workingDayId], references: [id], onDelete: Cascade)

  @@unique([workingDayId, sortOrder])
  @@index([workingDayId])
  @@map("clinic_working_shifts")
}

// =========================
// Clinic Working Day
// =========================

model ClinicWorkingDay {
  id String @id @default(uuid())

  clinicId String

  day WeekDay

  isClosed  Boolean @default(false)
  is24Hours Boolean @default(false)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  shifts ClinicWorkingShift[]

  @@unique([clinicId, day])
  @@index([clinicId])
  @@map("clinic_working_days")
}

// =========================
// Clinic Join Code
// =========================

model ClinicJoinCode {
  id String @id @default(uuid())

  clinicId String

  code String @unique

  expiresAt DateTime

  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([expiresAt])
  @@map("clinic_join_codes")
}

// =========================
// Patient
// =========================

model Patient {
  id String @id @default(uuid())

  patientCode String @unique

  clinicId String

  fullName String

  identifierType   String
  identifierNumber String?
  documentType     String?

  dateOfBirth       DateTime?
  estimatedAgeValue Int?
  estimatedAgeUnit  String?

  gender        Gender
  maritalStatus String
  childrenCount Int?

  phone      String?
  occupation String?

  governorate   String?
  city          String?
  district      String?
  streetAddress String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  // Past History
  chronicDiseases   PatientChronicDisease[]
  hospitalizations  PatientHospitalization[]
  operations        PatientOperation[]
  bloodTransfusions PatientBloodTransfusion[]
  majorTraumas      PatientMajorTrauma[]
  icuAdmissions     PatientICUAdmission[]

  // Drug History
  medications           PatientMedication[]
  medicationCompliance  String?
  selfMedication        Boolean             @default(false)
  selfMedicationDetails String?
  takesSupplements      Boolean             @default(false)
  supplementDetails     String?

  // Allergy History
  hasAllergy Boolean          @default(false)
  allergies  PatientAllergy[]

  // Family History
  familyHistory PatientFamilyHistory[]

  // Social History
  socialHistory PatientSocialHistory?

  // Vaccination History
  vaccinationHistory PatientVaccinationHistory?

  visits Visit[]

  @@index([clinicId])
  @@index([fullName])
  @@index([phone])
  @@map("patients")
}

// =========================
// Visit
// =========================

model Visit {
  id String @id @default(uuid())

  visitCode  String
  secureCode String @unique @default(uuid())

  patientId String
  clinicId  String

  createdById String
  doctorId    String

  visitStatus VisitStatus @default(WAITING)

  visitDate DateTime @default(now())

  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  cancellationReason String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient   Patient @relation(fields: [patientId], references: [id])
  clinic    Clinic  @relation(fields: [clinicId], references: [id])
  createdBy User    @relation("VisitCreatedBy", fields: [createdById], references: [id])
  doctor    User    @relation("VisitDoctor", fields: [doctorId], references: [id])

  chiefComplaint VisitChiefComplaint?

  relatedSystems   VisitRelatedSystem[]
  systematicReview VisitSystematicReview[]

  // Menstrual History
  menstrualHistory VisitMenstrualHistory?

  // Pediatric History
  pediatricHistory VisitPediatricHistory?

  // Examination
  vitalSigns        VisitVitalSigns?
  generalInspection VisitGeneralInspection?

  regionalExaminations VisitRegionalExamination[]
  systemExaminations   VisitSystemExamination[]

  // Assessment
  diagnosis VisitDiagnosis?

  investigations VisitInvestigation[]
  procedures     VisitProcedure[]
  referrals      VisitReferral[]

  prescription VisitPrescription?

  @@unique([clinicId, visitCode])
  @@index([patientId])
  @@index([doctorId])
  @@index([clinicId])
  @@index([visitDate])
  @@index([visitStatus])
  @@map("visits")
}

// =========================
// Patient Chronic Disease
// =========================

model PatientChronicDisease {
  id String @id @default(uuid())

  patientId String

  diseaseCode String
  diseaseName String

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([diseaseCode])
  @@map("patient_chronic_diseases")
}

// =========================
// Patient Hospitalization
// =========================

model PatientHospitalization {
  id String @id @default(uuid())

  patientId String

  reason   String
  date     DateTime?
  duration String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_hospitalizations")
}

// =========================
// Patient Operation
// =========================

model PatientOperation {
  id String @id @default(uuid())

  patientId String

  operationName String
  date          DateTime?
  indication    String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_operations")
}

// =========================
// Patient Blood Transfusion
// =========================

model PatientBloodTransfusion {
  id String @id @default(uuid())

  patientId String

  reason   String?
  date     DateTime?
  reaction String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_blood_transfusions")
}

// =========================
// Patient Major Trauma
// =========================

model PatientMajorTrauma {
  id String @id @default(uuid())

  patientId String

  traumaType    String
  date          DateTime?
  complications String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_major_traumas")
}

// =========================
// Patient ICU Admission
// =========================

model PatientICUAdmission {
  id String @id @default(uuid())

  patientId String

  reason            String
  date              DateTime?
  duration          String?
  ventilatorSupport Boolean   @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_icu_admissions")
}

// =========================
// Patient Medication
// =========================

model PatientMedication {
  id String @id @default(uuid())

  patientId String

  medicationName String
  dose           String?

  durationValue Int?
  durationUnit  String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_medications")
}

// =========================
// Patient Allergy
// =========================

model PatientAllergy {
  id String @id @default(uuid())

  patientId String

  type     String
  allergen String
  reaction String?
  severity String

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([type])
  @@index([allergen])
  @@map("patient_allergies")
}

// =========================
// Patient Family History
// =========================

model PatientFamilyHistory {
  id String @id @default(uuid())

  patientId String

  relation      String
  otherRelation String?

  diseases String[]

  alive Boolean

  ageAtDeath   Int?
  causeOfDeath String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([relation])
  @@map("patient_family_history")
}

// =========================
// Patient Social History
// =========================

model PatientSocialHistory {
  id String @id @default(uuid())

  patientId String @unique

  smoking            String?
  cigarettesPerDay   Int?
  yearsSmoking       Int?
  yearsSinceQuitting Int?

  alcohol            String?
  alcoholFrequency   String?
  yearsSinceStopping Int?

  livingCondition      String?
  livingConditionNotes String?

  substanceUse   String[]
  substanceNotes String?

  physicalActivity      String?
  physicalActivityNotes String?

  sleepDuration String?
  sleepNotes    String?

  socialSupport      String?
  socialSupportNotes String?

  sexualHistory      String?
  sexualHistoryNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_social_history")
}

// =========================
// Patient Vaccination History
// =========================

model PatientVaccinationHistory {
  id String @id @default(uuid())

  patientId String @unique

  vaccinationStatus String?

  missedVaccines String[]

  partialReason       String?
  partialOtherDetails String?

  unvaccinatedReason       String?
  unvaccinatedOtherDetails String?

  previousReaction Boolean?

  reactionSeverity String?
  reactionDetails  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_vaccination_history")
}

// =========================
// Visit Menstrual History
// =========================

model VisitMenstrualHistory {
  id String @id @default(uuid())

  visitId String @unique

  ageAtMenarche Int?

  cycleRegularity String?
  cycleLength     Int?

  bleedingDuration String?
  menstrualFlow    String?

  dysmenorrhea String?

  painStarts     String?
  painRelievedBy String[]

  associatedSymptoms String[]

  intermenstrualBleeding Boolean?
  postcoitalBleeding     Boolean?

  pmsSymptoms String[]

  lmp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("visit_menstrual_history")
}

// =========================
// Visit Pediatric History
// =========================

model VisitPediatricHistory {
  id String @id @default(uuid())

  visitId String @unique

  // =========================
  // Prenatal History
  // =========================

  antenatalCare      String?
  antenatalCareNotes String?

  maternalIllnesses    String[]
  maternalIllnessOther String?

  pregnancyComplications      String[]
  pregnancyComplicationsOther String?

  drugIntake        Boolean?
  drugIntakeDetails String?

  smokingExposure String?

  alcoholExposure        Boolean?
  alcoholExposureDetails String?

  // =========================
  // Birth History
  // =========================

  gestationalAge   String?
  gestationalWeeks Int?

  deliveryMode String?

  birthWeight Int?

  nicuAdmission Boolean?
  nicuReason    String?
  nicuDuration  Int?

  birthComplications       String[]
  birthComplicationDetails String?

  // =========================
  // Neonatal History
  // =========================

  neonatalJaundice Boolean?

  phototherapy        Boolean?
  exchangeTransfusion Boolean?

  neonatalSeizures Boolean?

  // =========================
  // Feeding History
  // =========================

  feedingTypes String[]

  // =========================
  // Development History
  // =========================

  development String?

  delayType    String?
  delayDetails String?

  // =========================
  // School History
  // =========================

  attendsSchool Boolean?

  grade String?

  schoolPerformance        String?
  schoolPerformanceDetails String?

  schoolAttendance       String?
  schoolAttendanceReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("visit_pediatric_history")
}

// =========================
// Chief Complaint
// =========================

model VisitChiefComplaint {
  id String @id @default(uuid())

  visitId String @unique

  chiefComplaintId String

  durationValue Int?
  durationUnit  String?

  analysis VisitComplaintAnalysis?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  chiefComplaint ChiefComplaintMaster @relation(fields: [chiefComplaintId], references: [id])

  @@index([chiefComplaintId])
  @@map("visit_chief_complaints")
}

// =========================
// Chief Complaint Master
// =========================

model ChiefComplaintMaster {
  id String @id @default(uuid())

  code String @unique

  name String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template ChiefComplaintTemplate?

  visitChiefComplaints VisitChiefComplaint[]

  @@index([name])
  @@map("chief_complaint_master")
}

// =========================
// Chief Complaint Template
// =========================

model ChiefComplaintTemplate {
  id String @id @default(uuid())

  chiefComplaintId String @unique

  version Int @default(1)

  template Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chiefComplaint ChiefComplaintMaster @relation(fields: [chiefComplaintId], references: [id], onDelete: Cascade)

  @@map("chief_complaint_templates")
}

// =========================
// Complaint Analysis
// =========================

model VisitComplaintAnalysis {
  id String @id @default(uuid())

  visitChiefComplaintId String @unique

  templateCode    String
  templateVersion Int

  values Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitChiefComplaint VisitChiefComplaint @relation(fields: [visitChiefComplaintId], references: [id], onDelete: Cascade)

  @@index([templateCode])
  @@map("visit_complaint_analysis")
}

// =========================
// Related System
// =========================

model VisitRelatedSystem {
  id String @id @default(uuid())

  visitId String

  system String

  symptoms String[]

  otherFinding String?

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, system])
  @@index([visitId])
  @@map("visit_related_systems")
}

// =========================
// Systematic Review
// =========================

model VisitSystematicReview {
  id String @id @default(uuid())

  visitId String

  system String

  symptoms String[]

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, system])
  @@index([visitId])
  @@map("visit_systematic_review")
}

// =========================
// Vital Signs
// =========================

model VisitVitalSigns {
  id String @id @default(uuid())

  visitId String @unique

  systolicBP  Int?
  diastolicBP Int?

  heartRate   Int?
  pulseRhythm String?

  respiratoryRate Int?

  spo2         Int?
  oxygenSource String?

  temperature      Decimal? @db.Decimal(4, 1)
  temperatureRoute String?

  bloodGlucose Int?

  weight Decimal? @db.Decimal(5, 2)
  height Decimal? @db.Decimal(5, 2)

  bmi Decimal? @db.Decimal(4, 1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("visit_vital_signs")
}

// =========================
// General Inspection
// =========================

model VisitGeneralInspection {
  id String @id @default(uuid())

  visitId String @unique

  consciousness String?
  appearance    String?
  hydration     String?
  bodyBuild     String?
  nourishment   String?

  findings String[]

  edemaLocations String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("visit_general_inspection")
}

// =========================
// Regional Examination
// =========================

model VisitRegionalExamination {
  id String @id @default(uuid())

  visitId String

  area String

  findings String[]

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, area])
  @@index([visitId])
  @@map("visit_regional_examinations")
}

// =========================
// System Examination
// =========================

model VisitSystemExamination {
  id String @id @default(uuid())

  visitId String

  system String

  fields Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, system])
  @@index([visitId])
  @@map("visit_system_examinations")
}

// =========================
// Diagnosis
// =========================

model VisitDiagnosis {
  id String @id @default(uuid())

  visitId String @unique

  primaryDiagnosisCode String?
  primaryDiagnosisName String?

  differentialDiagnoses Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([primaryDiagnosisCode])
  @@map("visit_diagnoses")
}

// =========================
// Investigation
// =========================

model VisitInvestigation {
  id String @id @default(uuid())

  visitId String

  code String?

  name String

  status InvestigationStatus @default(REQUESTED)

  result Json?

  notes String?

  requestedAt DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  images VisitInvestigationImage[]

  @@index([visitId])
  @@index([status])
  @@map("visit_investigations")
}

// =========================
// Investigation Result Image
// =========================

model VisitInvestigationImage {
  id String @id @default(uuid())

  investigationId String

  fileUrl   String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())

  investigation VisitInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId])
  @@map("visit_investigation_images")
}

// =========================
// Procedure
// =========================

model VisitProcedure {
  id String @id @default(uuid())

  visitId String

  details String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("visit_procedures")
}

// =========================
// Referral
// =========================

model VisitReferral {
  id String @id @default(uuid())

  visitId String

  details String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("visit_referrals")
}

// =========================
// Prescription Template Folder
// =========================

model PrescriptionTemplateFolder {
  id String @id @default(uuid())

  name String

  scope PrescriptionTemplateScope

  userId   String?
  clinicId String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  templates PrescriptionTemplate[]

  @@index([userId])
  @@index([clinicId])
  @@index([scope])
  @@map("prescription_template_folders")
}

// =========================
// Prescription Template
// =========================

model PrescriptionTemplate {
  id String @id @default(uuid())

  title String

  scope PrescriptionTemplateScope

  userId   String?
  clinicId String?

  folderId String?

  advice   String?
  notes    String?
  followUp String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  folder PrescriptionTemplateFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  medications PrescriptionTemplateMedication[]

  @@index([userId])
  @@index([clinicId])
  @@index([folderId])
  @@index([scope])
  @@map("prescription_templates")
}

// =========================
// Prescription Template Medication
// =========================

model PrescriptionTemplateMedication {
  id String @id @default(uuid())

  templateId String

  medication   String
  instructions String?

  durationValue Int?
  durationUnit  String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template PrescriptionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("prescription_template_medications")
}

// =========================
// Prescription
// =========================

model VisitPrescription {
  id String @id @default(uuid())

  visitId String @unique

  advice String?

  notes String?

  followUp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  medications VisitPrescriptionMedication[]

  @@map("visit_prescriptions")
}

// =========================
// Prescription Medication
// =========================

model VisitPrescriptionMedication {
  id String @id @default(uuid())

  prescriptionId String

  medication String

  durationValue Int?
  durationUnit  String?

  instructions String?

  sortOrder Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescription VisitPrescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("visit_prescription_medications")
}

// =========================
// System Counter
// =========================

model SystemCounter {
  id        String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("system_counters")
}
